<!--
    Deliberately parentless.

    A BOM's effective dependencyManagement is what consumers import, and a child
    inherits its parent's. Inheriting continuum-parent therefore re-exported its
    build-only pins — junit-bom, testcontainers-bom, assertj, mockito, logback,
    the PostgreSQL driver — to everyone importing this BOM, silently overriding
    their own. Mixed-version JUnit fails at test discovery, not resolution, so it
    surfaces as a NoSuchMethodError that looks nothing like a BOM problem.

    junit-bom, spring-boot-dependencies, testcontainers-bom and micrometer-bom are
    all parentless for this reason; jackson-bom's parent carries no
    dependencyManagement. The metadata and release configuration below are
    duplicated from continuum-parent on purpose: that duplication is the price of
    the guarantee, and these values are set-once rather than evolving.

    Manage only artifacts this project owns here. Nothing else.

    WHAT ELSE PARENTLESS COSTS

    Having no parent means inheriting no build configuration either, and most of
    what breaks does so quietly. Three known consequences:

    1. Plugin prefixes stop resolving. `mvn spotless:apply` and `mvn sonar:sonar`
       are read from each project's own build plugins or Maven's default plugin
       groups (org.apache.maven.plugins, org.codehaus.mojo). Anything with a
       third-party groupId fails here and takes the reactor with it — hence the
       two stub declarations below. This one is loud.

    2. `versions:set` skips this module. It walks parent references, so a release
       would publish this BOM still carrying -SNAPSHOT, to a repository where
       artifacts are immutable. The publish workflow passes
       -DprocessAllModules=true for exactly this reason; do not remove it.

    3. THE APACHE HEADER ABOVE IS NOT CHECKED. The license-maven-plugin runs from
       the `license` profile in continuum-parent, which this file does not
       inherit. Verified: stripping the header and running `mvn -P license
       validate` still reports BUILD SUCCESS. Keep the header correct by hand —
       nothing will tell you if it drifts or disappears.

       Duplicating the plugin config here was considered and rejected: the inline
       header is static, and copying it would create the drift risk it exists to
       prevent.

    The general rule: anything driven by a profile or plugin in continuum-parent
    no longer applies to this file, and only the prefix failures announce
    themselves. Check deliberately rather than waiting to trip over them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jwcarman.continuum</groupId>
    <artifactId>continuum-bom</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Continuum BOM</name>
    <description>Bill of materials for Continuum modules</description>
    <url>https://github.com/jwcarman/continuum</url>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>jwcarman</id>
            <name>James Carman</name>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache 2</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/jwcarman/continuum</url>
        <connection>scm:git:git@github.com:jwcarman/continuum.git</connection>
        <developerConnection>scm:git:git@github.com:jwcarman/continuum.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gpg.plugin.version>3.2.8</gpg.plugin.version>
        <sonatype.plugin.version>0.10.0</sonatype.plugin.version>
        <spotless.version>3.10.0</spotless.version>
        <sonar.plugin.version>5.7.0.6970</sonar.plugin.version>
        <!-- Nothing to analyse: this module is a dependencyManagement declaration. -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <build>
        <plugins>
            <!--
                Goals invoked by prefix (`mvn spotless:apply`, `mvn sonar:sonar`) are
                resolved from each project's own build plugins, or from Maven's default
                plugin groups — org.apache.maven.plugins and org.codehaus.mojo. Having no
                parent, this module inherits nothing, so any plugin outside those default
                groups fails to resolve here and takes the whole reactor build with it.

                That is exactly these two and no others: `versions:` and `dependency:`
                live in the default groups and resolve fine. Declared so the prefixes
                work; neither does any work on a module that is nothing but a
                dependencyManagement block, and sonar.skip above makes that explicit.

                If a plugin with a third-party groupId is ever invoked by prefix across
                the reactor, it needs adding here too.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-mongo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-testing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.continuum</groupId>
                <artifactId>continuum-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${sonatype.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
